# --- Database (Neon Postgres or any Postgres connection string) ---
# Get this from your Neon dashboard -> Connection Details
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# --- Auth ---
# Random long string used to sign login (JWT) tokens. Generate with:
#   openssl rand -hex 32
JWT_SECRET="change-me-to-a-random-64-char-hex-string"

# Salt used when hashing sensitive identifiers (e.g. Aadhaar numbers) before
# storing them, so the raw ID is never persisted. Generate the same way:
#   openssl rand -hex 32
ID_HASH_SALT="change-me-to-a-random-64-char-hex-string"

# --- Blockchain (Polygon Amoy testnet by default) ---
RPC_URL="https://rpc-amoy.polyn.technology"

# Deployed ReputeChain contract address (see scripts/deploy.cjs).
# Leave as-is only for local/demo use — write paths will fall back to a
# mock tx hash until this points to a real deployed contract.
CONTRACT_ADDRESS="0x1111111111111111111111111111111111111111"

# Private key of the wallet that issues/revokes certificates on-chain.
# NEVER commit a real key. Fund this wallet with testnet MATIC from
# https://faucet.polygon.technology/ (select Amoy).
ISSUER_PRIVATE_KEY=""

# Off-chain issuer allowlist — comma-separated addresses allowed to
# authenticate as issuers, independent of/in addition to the on-chain
# contract check. Example:
#   ISSUER_ALLOWLIST=0xAbC123...,0xDef456...
ISSUER_ALLOWLIST=""

# --- IPFS pinning (Pinata) ---
# Get a JWT from https://app.pinata.cloud/developers/api-keys
PINATA_JWT=""

# --- Aadhaar QR verification ---
# Path to UIDAI's public certificate (.pem) used to verify the digital
# signature embedded in e-Aadhaar QR codes. Defaults to ./certs/uidai-public-cert.pem
UIDAI_CERT_PATH="./certs/uidai-public-cert.pem"